# Flask Application Secret Key (Change this in production)
SECRET_KEY=dev-secret-key-change-in-production-random-64-chars

# Database URL (Optional: defaults to safe instance SQLite path finance.db)
DATABASE_URL=sqlite:///instance/finance.db

# Google Gemini API Configuration (Optional: fallback engine will be used if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Port (Default: 5000)
PORT=5000
FLASK_ENV=development
